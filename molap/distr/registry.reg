Windows Registry Editor Version 5.00

[HKEY_LOCAL_MACHINE\Software\Foresight\Foresight Analytics Platform\${FP_RELEASE}.0\Debug]
"MatrixCountLogging"=dword:00000001
"CurlOptVerbose"=dword:00000001

[HKEY_LOCAL_MACHINE\Software\Foresight\Foresight Analytics Platform\${FP_RELEASE}.0\Log]
"SeverityLevel"=dword:00000001
"WriteToDebugOutput"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Foresight\Foresight Analytics Platform\${FP_RELEASE}.0\PoolTrace]
@="0"
